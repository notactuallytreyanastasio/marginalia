#!/usr/bin/env bash
# Regenerates the Elixir in temper/out from the Temper sources in temper/.
#
#   bin/temper-gen           rebuild temper/out
#   bin/temper-gen --check   rebuild elsewhere and fail if temper/out differs
#
# temper/out is committed, so building and deploying Marginalia needs no
# JVM and no Temper: only regenerating does. TEMPER names the temper CLI to
# use (default: the be-elixir build in TEMPER_BLIMP, ~/code/temper-elixir);
# temper/out/TEMPER_COMMIT records which temper-blimp commit made the code.
set -euo pipefail
cd "$(dirname "$0")/.."
TEMPER_BLIMP="${TEMPER_BLIMP:-$HOME/code/temper-elixir}"
TEMPER="${TEMPER:-$TEMPER_BLIMP/temper/cli/build/install/temper/bin/temper}"
export JAVA_HOME="${JAVA_HOME:-/opt/homebrew/opt/openjdk@21}"

if [ ! -x "$TEMPER" ]; then
  echo "temper-gen: no temper CLI at $TEMPER" >&2
  echo "  build it: (cd $TEMPER_BLIMP/temper && ./gradlew :cli:installDist), or set TEMPER" >&2
  exit 1
fi

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
for lib in temper/*/; do
  [ -f "$lib/config.temper.md" ] && rsync -a --exclude temper.out "$lib" "$work/$(basename "$lib")/"
done

if ! (cd "$work" && "$TEMPER" build -b elixir -w . > "$work/build.log" 2>&1); then
  cat "$work/build.log" >&2
  echo "temper-gen: temper build failed" >&2
  exit 1
fi

out="$work/temper.out/elixir"
find "$out" -name '*.map' -delete
commit=$(git -C "$TEMPER_BLIMP" rev-parse HEAD)
if [ -n "$(git -C "$TEMPER_BLIMP" status --porcelain -- temper/be-elixir temper/frontend)" ]; then
  commit="$commit (with uncommitted changes)"
fi

if [ "${1:-}" = "--check" ]; then
  if ! diff -r -q "$out" temper/out --exclude TEMPER_COMMIT > "$work/diff.txt"; then
    cat "$work/diff.txt" >&2
    echo "temper-gen: temper/out is stale; run bin/temper-gen and commit the result" >&2
    exit 1
  fi
  echo "temper/out is current"
else
  echo "$commit" > "$out/TEMPER_COMMIT"
  rm -rf temper/out
  cp -R "$out" temper/out
  echo "temper/out regenerated by temper-blimp $commit"
fi
