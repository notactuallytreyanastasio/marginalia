# Blimp for the @connected declarations of core (sentences, reflow, segmenter).
#
# The backend splices this file in beside temper-core and gives each @connected
# declaration a body that calls `connected_<name>`. Every helper here is
# prefixed `core_` so that none of them can shadow a builtin.
#
# The class tables below are GENERATED, not written by hand: tools/dump.exs
# asks Elixir (`elixir tools/dump.exs > dump.txt`) and tools/gen.py turns the
# answer into this code (`python3 tools/gen.py dump.txt`, minus the upcase
# line, which the builtin answers). The data is what Elixir's own regexes
# say, taken by asking PCRE (with the `u` flag, as the sentence rules had)
# about every code
# point from U+0080 to U+10FFFF:
#   \s   -> core_space_hi        \p{Lu} -> core_upper_hi     \d  -> core_digit_hi
#   \p{L} -> core_letter_hi      \p{N}  -> core_number_hi

# Each is a binary decision tree on the code point, so a lookup is about ten
# comparisons whatever the class. ASCII is answered before the tree is asked.

def core_space_hi(cp: Int) -> Any do
  case cp < 8192 do
    true ->
      case cp < 5760 do
        true ->
          case cp < 160 do
            true ->
              cp == 133
            _ ->
              cp == 160
          end
        _ ->
          case cp < 6158 do
            true ->
              cp == 5760
            _ ->
              cp == 6158
          end
      end
    _ ->
      case cp < 8239 do
        true ->
          case cp < 8232 do
            true ->
              cp >= 8192 and cp <= 8202
            _ ->
              cp >= 8232 and cp <= 8233
          end
        _ ->
          case cp < 8287 do
            true ->
              cp == 8239
            _ ->
              case cp < 12288 do
                true ->
                  cp == 8287
                _ ->
                  cp == 12288
              end
          end
      end
  end
end

