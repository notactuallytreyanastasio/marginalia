                  case cp < 120782 do
                    true ->
                      case cp < 119520 do
                        true ->
                          case cp < 119488 do
                            true ->
                              cp >= 118000 and cp <= 118009
                            _ ->
                              cp >= 119488 and cp <= 119507
                          end
                        _ ->
                          case cp < 119648 do
                            true ->
                              cp >= 119520 and cp <= 119539
                            _ ->
                              cp >= 119648 and cp <= 119672
                          end
                      end
                    _ ->
                      case cp < 123632 do
                        true ->
                          case cp < 123200 do
                            true ->
                              cp >= 120782 and cp <= 120831
                            _ ->
                              cp >= 123200 and cp <= 123209
                          end
                        _ ->
                          case cp < 124144 do
                            true ->
                              cp >= 123632 and cp <= 123641
                            _ ->
                              case cp < 124401 do
                                true ->
                                  cp >= 124144 and cp <= 124153
                                _ ->
                                  cp >= 124401 and cp <= 124410
                              end
                          end
                      end
                  end
                _ ->
                  case cp < 126129 do
                    true ->
                      case cp < 126065 do
                        true ->
                          case cp < 125264 do
                            true ->
                              cp >= 125127 and cp <= 125135
                            _ ->
                              cp >= 125264 and cp <= 125273
                          end
                        _ ->
                          case cp < 126125 do
                            true ->
                              cp >= 126065 and cp <= 126123
                            _ ->
                              cp >= 126125 and cp <= 126127
                          end
                      end
                    _ ->
                      case cp < 126255 do
                        true ->
                          case cp < 126209 do
                            true ->
                              cp >= 126129 and cp <= 126132
                            _ ->
                              cp >= 126209 and cp <= 126253
                          end
                        _ ->
                          case cp < 127232 do
                            true ->
                              cp >= 126255 and cp <= 126269
                            _ ->
                              case cp < 130032 do
                                true ->
                                  cp >= 127232 and cp <= 127244
                                _ ->
                                  cp >= 130032 and cp <= 130041
                              end
                          end
                      end
                  end
              end
          end
      end
  end
end

# ---------------------------------------------------------------------------
# The nine functions. Parameters arrive as Any; nil never arrives, but is
# answered the way an absent code point or an empty string would be.

def core_valid_cp(cp: Any) -> Any do
  cp >= 0 and cp <= 1114111 and not(cp >= 55296 and cp <= 57343)
end

# \s with /u: 9-13, 32, then U+0085, U+00A0, U+1680, U+180E, U+2000-200A,
# U+2028-2029, U+202F, U+205F, U+3000.
def connected_isUnicodeSpace(cp: Any) -> Any do
  case nil?(cp) do
    true -> false
    _ -> case cp < 128 do
      true -> cp == 32 or (cp >= 9 and cp <= 13)
      _ -> core_space_hi(cp)
    end
  end
end

# \p{Lu}
def connected_isUnicodeUpper(cp: Any) -> Any do
  case nil?(cp) do
    true -> false
    _ -> case cp < 128 do
      true -> cp >= 65 and cp <= 90
      _ -> core_upper_hi(cp)
    end
  end
end

# \d with /u is \p{Nd}
def connected_isUnicodeDigit(cp: Any) -> Any do
  case nil?(cp) do
    true -> false
    _ -> case cp < 128 do
      true -> cp >= 48 and cp <= 57
      _ -> core_digit_hi(cp)
    end
  end
end

# \p{L}
def connected_isUnicodeLetter(cp: Any) -> Any do
  case nil?(cp) do
    true -> false
    _ -> case cp < 128 do
      true -> (cp >= 97 and cp <= 122) or (cp >= 65 and cp <= 90)
      _ -> core_letter_hi(cp)
    end
  end
end

# \p{N}
def connected_isUnicodeNumber(cp: Any) -> Any do
  case nil?(cp) do
    true -> false
    _ -> case cp < 128 do
      true -> cp >= 48 and cp <= 57
      _ -> core_number_hi(cp)
    end
  end
end

# String.upcase(<<cp::utf8>>) == <<cp::utf8>>: true when upcasing the single
# character changes nothing (digits, punctuation, capitals, caseless letters).
# A value that is no code point at all changes nothing either.
def connected_isUpcaseFixed(cp: Any) -> Any do
  case nil?(cp) do
    true -> true
    _ -> case cp < 128 do
      true -> not(cp >= 97 and cp <= 122)
      _ -> case core_valid_cp(cp) do
        true -> utf8_upcase(u8_encode(cp)) == u8_encode(cp)
        _ -> true
      end
    end
  end
end

# String.downcase/1: whole string, so the Greek sigma rule is the library's.
def connected_downcase(s: Any) -> Any do
  case nil?(s) do
    true -> ""
    _ -> utf8_downcase(core_clean(s))
  end
end

# String.length/1 counts extended grapheme clusters.
def connected_graphemeLength(s: Any) -> Any do
  case nil?(s) do
    true -> 0
    _ -> grapheme_length(core_clean(s))
  end
end

# String.slice(s, 0, n): the first n clusters.
def connected_graphemePrefix(s: Any, n: Any) -> Any do
  case nil?(s) do
    true -> ""
    _ -> case nil?(n) or n <= 0 do
      true -> ""
      _ -> grapheme_take(core_clean(s), n)
    end
  end
end

# The utf8_* builtins raise on invalid UTF-8; a library that is handed bytes
# from a PDF would rather lose the bad bytes than the request.
def core_clean(s: Any) -> Any do
  case utf8_valid(s) do
    true -> s
    _ -> utf8_scrub(s)
  end
end

# Wall clock for the timing harness.
def connected_coreNowMs() -> Any do
  now_ms()
end
