# Blimp bodies for the @connected declarations in sys.temper.md.
#
# The backend splices this file in beside temper-core and gives each
# declaration a body that calls `connected_<name>`. Parameters are `Any`
# because a typed Blimp parameter crashes on nil. Helpers are prefixed `sys_`
# so nothing here can shadow a builtin for every program this is spliced into.

# ── Files ────────────────────────────────────────────

def connected_sysReadFile(path: Any) -> Any do read_file(path) end
def connected_sysWriteFile(path: Any, data: Any) -> Any do write_file(path, data) end
def connected_sysAppendFile(path: Any, data: Any) -> Any do
  append_file(path, data)
  nil
end
def connected_sysListDir(path: Any) -> Any do
  names = list_dir(path)
  case nil?(names) do
    true -> []
    _ -> names
  end
end
def connected_sysFileSize(path: Any) -> Any do
  n = file_size(path)
  case nil?(n) do
    true -> 0 - 1
    _ -> n
  end
end

# ── Environment and process ──────────────────────────

def connected_sysGetEnv(name: Any) -> Any do getenv(name) end
def connected_sysArgv() -> Any do argv() end
def connected_sysExit(code: Any) -> Any do exit(code) end
def connected_sysFork() -> Any do fork() end
def connected_sysWaitPid(pid: Any, no_hang: Any) -> Any do waitpid(pid, no_hang) end

def connected_sysReapChildren() -> Any do sys_reap([]) end
def sys_reap(acc: Any) -> Any do
  pid = waitpid(0 - 1, true)
  case pid > 0 do
    true -> sys_reap(append(acc, pid))
    _ -> acc
  end
end

def connected_sysExec(argv_list: Any, stdin: Any, cwd: Any) -> Any do
  r = exec(argv_list, stdin, cwd)
  [to_string(elem(r, 0)), elem(r, 1), elem(r, 2)]
end

def connected_sysSleepMs(ms: Any) -> Any do
  sleep_ms(ms)
  nil
end

def connected_sysRss() -> Any do lookup(process_stats(), "rss_bytes") end

# ── Time ─────────────────────────────────────────────

def connected_sysNowMs() -> Any do now() * 1000 end
def connected_sysMonoMs() -> Any do now_ms() end
def connected_sysUtcNow() -> Any do format_time(now(), "%Y-%m-%d %H:%M:%S") end
def connected_sysUtcFromMs(ms: Any) -> Any do format_time(ms / 1000, "%Y-%m-%d %H:%M:%S") end

# ── Bytes, text and hashes ───────────────────────────

def connected_sysByteLength(s: Any) -> Any do length(s) end
def connected_sysSha256(s: Any) -> Any do sha256(s) end
def connected_sysHmacSha256(key: Any, msg: Any) -> Any do hmac_sha256(key, msg) end
def connected_sysPbkdf2(password: Any, salt_hex: Any, iterations: Any, dklen: Any) -> Any do
  pbkdf2_sha256(password, salt_hex, iterations, dklen)
end
def connected_sysRandomHex(n: Any) -> Any do hex_encode(random_bytes(n)) end
def connected_sysRandomToken() -> Any do random_token(32) end
def connected_sysBase64(s: Any) -> Any do base64_encode(s) end
def connected_sysBase64Decode(s: Any) -> Any do
  try do
    base64_decode(s)
  catch e do
    nil
  end
end
def connected_sysConstantTimeEq(a: Any, b: Any) -> Any do constant_time_eq(a, b) end
def connected_sysUtf8Valid(s: Any) -> Any do utf8_valid(s) end
def connected_sysUtf8Downcase(s: Any) -> Any do utf8_downcase(s) end
def connected_sysUtf8Upcase(s: Any) -> Any do utf8_upcase(s) end
def connected_sysGraphemeLength(s: Any) -> Any do grapheme_length(s) end
def connected_sysGraphemeTake(s: Any, n: Any) -> Any do grapheme_take(s, n) end
def connected_sysStringReplace(s: Any, from: Any, to: Any) -> Any do replace(s, from, to) end
def connected_sysStringTrim(s: Any) -> Any do temper_trim(s) end
def connected_sysJoin(parts: Any, sep: Any) -> Any do join(temper_items(parts), sep) end

# A Temper List arrives as a Blimp list; a Temper ListBuilder would be an
# actor, which temper_items unwraps either way. The tree below that is plain
# nested lists with string leaves. `flat` refuses a non-list element, so each
# pass wraps the leaves before flattening; `flat_deep` (interpreter branch
# 115) does the whole thing in one native call.
def connected_sysFlatJoin(parts: Any) -> Any do
  join(sys_flat_deep(temper_items(parts)), "")
end
def sys_flat_deep(xs: Any) -> Any do
  case sys_any_list(xs) do
    true -> sys_flat_deep(flat(map(xs, fn(v: Any) -> Any do sys_as_list(v) end)))
    _ -> xs
  end
end
def sys_as_list(v: Any) -> Any do
  case type_of(v) == :list do
    true -> v
    _ -> [v]
  end
end
def sys_any_list(xs: Any) -> Any do
  length(filter(xs, fn(v: Any) -> Bool do type_of(v) == :list end)) > 0
end

# ── Sockets ──────────────────────────────────────────

# tcp_listen raises for every reason; the reason is nearly always the port.
# `bubble` is only legal in a handler or a case arm, so the failure travels
# out as a value first.
def connected_sysListen(port: Any) -> Any do
  fd = try do
    tcp_listen(port)
  catch e do
    0 - 1
  end
  case fd < 0 do
    true -> bubble concat("cannot listen on port ", concat(to_string(port), " -- something else is probably already on it"))
    _ -> fd
  end
end

def connected_sysAccept(fd: Any) -> Any do tcp_accept(fd) end

def connected_sysWrite(fd: Any, data: Any) -> Any do
  r = tcp_write(fd, data)
  r != :error
end

def connected_sysClose(fd: Any) -> Any do
  tcp_close(fd)
  nil
end

def connected_sysCloseFd(fd: Any) -> Any do
  fd_close(fd)
  nil
end

# Read a whole HTTP request: the header block, then Content-Length bytes of
# body. Chunks are kept in a list and joined once, because concat in a loop
# copies everything so far on every step. The header search joins what has
# arrived so far, which is one or two segments in practice.
def connected_sysReadRequest(fd: Any, max_bytes: Any) -> Any do
  sys_read_headers(fd, [], 0, max_bytes)
end

def sys_read_headers(fd: Any, chunks: Any, total: Any, max_bytes: Any) -> Any do
  chunk = tcp_read(fd)
  case nil?(chunk) do
    true -> sys_headers_ended(chunks)
    _ -> case chunk == "" do
      true -> sys_headers_ended(chunks)
      _ -> sys_headers_more(fd, append(chunks, chunk), total + length(chunk), max_bytes)
    end
  end
end

# The client closed before a blank line arrived: nil for nothing at all,
# otherwise whatever came (a request line with no headers still parses).
def sys_headers_ended(chunks: Any) -> Any do
  case length(chunks) == 0 do
    true -> nil
    _ -> join(chunks, "")
  end
end

def sys_headers_more(fd: Any, chunks: Any, total: Any, max_bytes: Any) -> Any do
  so_far = join(chunks, "")
  at = index_of(so_far, "\r\n\r\n")
  case at < 0 do
    true -> case total > 65536 do
      true -> sys_truncated(so_far)
      _ -> sys_read_headers(fd, [so_far], total, max_bytes)
    end
    _ -> sys_body_phase(fd, so_far, total, at + 4, sys_content_length(slice(so_far, 0, at)), max_bytes)
  end
end

# A declared body longer than the cap is refused before it is read: the
# marker goes in and whatever arrived is handed back.
def sys_body_phase(fd: Any, so_far: Any, total: Any, body_start: Any, want: Any, max_bytes: Any) -> Any do
  case want > max_bytes do
    true -> sys_truncated(so_far)
    _ -> sys_read_body(fd, [so_far], total, body_start + want, max_bytes)
  end
end

def sys_content_length(head: Any) -> Any do
  lower = downcase(head)
  at = index_of(lower, "\r\ncontent-length:")
  case at < 0 do
    true -> 0
    _ -> sys_header_int(slice(lower, at + 17, length(lower) - (at + 17)))
  end
end

def sys_header_int(rest: Any) -> Any do
  line = elem(split(rest, "\r\n"), 0)
  n = try do
    to_int(temper_trim(line))
  catch e do
    0
  end
  case nil?(n) do
    true -> 0
    _ -> n
  end
end

def sys_read_body(fd: Any, chunks: Any, total: Any, want: Any, max_bytes: Any) -> Any do
  case total >= want do
    true -> join(chunks, "")
    _ -> case total > max_bytes do
      true -> sys_truncated(join(chunks, ""))
      _ -> sys_read_body_more(fd, chunks, total, want, max_bytes)
    end
  end
end

def sys_read_body_more(fd: Any, chunks: Any, total: Any, want: Any, max_bytes: Any) -> Any do
  chunk = tcp_read(fd)
  case nil?(chunk) do
    true -> join(chunks, "")
    _ -> case chunk == "" do
      true -> join(chunks, "")
      _ -> sys_read_body(fd, append(chunks, chunk), total + length(chunk), want, max_bytes)
    end
  end
end

# The marker goes in as the first header line, after the request line, so a
# parser that knows nothing about it still sees a well-formed request.
def sys_truncated(raw: Any) -> Any do
  at = index_of(raw, "\r\n")
  case at < 0 do
    true -> concat(raw, "\r\nX-Blimp-Truncated: 1\r\n\r\n")
    _ -> concat(slice(raw, 0, at + 2), concat("X-Blimp-Truncated: 1\r\n", slice(raw, at + 2, length(raw) - (at + 2))))
  end
end

# ── HTTPS ────────────────────────────────────────────

# The builtin wants its headers as a map; Temper hands over "Name: value" lines.
def connected_sysHttpStart(method: Any, url: Any, headers: Any, body: Any, timeout_ms: Any) -> Any do
  http_start(method, url, sys_headers_map(temper_items(headers), %{}), body, %{timeout_ms: timeout_ms, max_redirects: 3})
end

def sys_headers_map(lines: Any, acc: Any) -> Any do
  case length(lines) == 0 do
    true -> acc
    _ -> sys_headers_map(tail(lines), sys_header_into(acc, head(lines)))
  end
end

def sys_header_into(acc: Any, line: Any) -> Any do
  at = index_of(line, ":")
  case at < 0 do
    true -> acc
    _ -> put(acc, temper_trim(slice(line, 0, at)), temper_trim(slice(line, at + 1, length(line) - (at + 1))))
  end
end

def connected_sysHttpResult(handle: Any) -> Any do
  r = http_result(handle)
  case r do
    nil -> nil
    {:ok, status, body} -> ["ok", to_string(status), body]
    {:error, reason} -> ["error", to_string(reason)]
    _ -> ["error", to_string(r)]
  end
end

# ── SQLite ───────────────────────────────────────────

def connected_sysDbOpen(path: Any) -> Any do sqlite_open(path) end
def connected_sysDbExec(db: Any, sql: Any) -> Any do sqlite_exec(db, sql) end
def connected_sysDbQuery(db: Any, sql: Any, params: Any) -> Any do
  sqlite_query(db, sql, temper_items(params))
end
def connected_sysDbLastId(db: Any) -> Any do sqlite_last_id(db) end
def connected_sysDbChanges(db: Any) -> Any do sqlite_changes(db) end
def connected_sysDbClose(db: Any) -> Any do
  sqlite_close(db)
  nil
end

# ── Test helpers (only the tests call these) ─────────

def connected_sysTestConnect(port: Any) -> Any do tcp_connect("127.0.0.1", port) end
def connected_sysTestSend(fd: Any, data: Any) -> Any do
  tcp_write(fd, data)
  nil
end
