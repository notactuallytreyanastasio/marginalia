# Blimp bodies for the @connected declarations in servertest.temper.md: a tiny
# HTTP client over tcp_connect. Only the tests call these.

# Connect, send `data`, read until the server closes, answer everything read.
def connected_serverTestRequest(port: Any, data: Any) -> Any do
  fd = tcp_connect("127.0.0.1", port)
  tcp_write(fd, data)
  chunks = server_test_read_all(fd, [])
  tcp_close(fd)
  join(chunks, "")
end

def server_test_read_all(fd: Any, acc: Any) -> Any do
  c = tcp_read(fd)
  case nil?(c) do
    true -> acc
    _ -> case c == "" do
      true -> acc
      _ -> server_test_read_all(fd, append(acc, c))
    end
  end
end

# A client that connects and leaves without a byte.
def connected_serverTestHangup(port: Any) -> Any do
  fd = tcp_connect("127.0.0.1", port)
  tcp_close(fd)
  nil
end
