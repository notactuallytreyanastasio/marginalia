#!/bin/sh
# Clustering: with DNS_CLUSTER_QUERY set (production: the compose service
# name, which resolves to every replica's address), each node is named
# marginalia@<its own address>. DNSCluster connects to <basename>@<ip> for
# every address the query returns, so the name has to be the address and
# not the container's random hostname.
#
# The cookie comes from RELEASE_COOKIE (MARGINALIA_RELEASE_COOKIE in the
# stack's .env). Without it each node would use the cookie baked into the
# image at build time: the same for every replica of one build, and the
# same for anyone who has the image.
if [ -n "$DNS_CLUSTER_QUERY" ]; then
  ip="$(hostname -i 2>/dev/null | awk '{print $1}')"
  if [ -z "$ip" ]; then
    ip="$(awk -v h="$(cat /etc/hostname)" '$2 == h { print $1; exit }' /etc/hosts)"
  fi
  export RELEASE_DISTRIBUTION=name
  export RELEASE_NODE="<%= @release.name %>@${ip}"
fi
